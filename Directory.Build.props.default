<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Windows defaults -->
    <GameFolderDefault>E:/SteamLibrary/steamapps/common/OxygenNotIncluded</GameFolderDefault>
    <AssemblyFolder>OxygenNotIncluded_Data/Managed</AssemblyFolder>
    <DevModsFolder>Klei/OxygenNotIncluded/mods/dev</DevModsFolder>

    <!-- Registry lookup is evaluated only on full MSBuild (Visual Studio MSBuild.exe). -->
    <GameFolderRegistryPrimary Condition="'$(MSBuildRuntimeType)' == 'Full'">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 457140', 'InstallLocation'))</GameFolderRegistryPrimary>
    <GameFolderRegistrySecondary Condition="'$(MSBuildRuntimeType)' == 'Full'">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 457140', 'InstallLocation'))</GameFolderRegistrySecondary>
    <GameFolderRegistry Condition="'$(GameFolderRegistry)' == '' and '$(GameFolderRegistryPrimary)' != ''">$(GameFolderRegistryPrimary)</GameFolderRegistry>
    <GameFolderRegistry Condition="'$(GameFolderRegistry)' == '' and '$(GameFolderRegistrySecondary)' != ''">$(GameFolderRegistrySecondary)</GameFolderRegistry>

    <GameFolderRegistryManaged Condition="'$(GameFolderRegistry)' != ''">$(GameFolderRegistry)/$(AssemblyFolder)</GameFolderRegistryManaged>
    <GameFolderRegistryValid Condition="'$(GameFolderRegistryManaged)' != '' and Exists('$(GameFolderRegistryManaged)/Assembly-CSharp.dll') and Exists('$(GameFolderRegistryManaged)/Assembly-CSharp-firstpass.dll') and Exists('$(GameFolderRegistryManaged)/UnityEngine.CoreModule.dll')">true</GameFolderRegistryValid>
    <GameFolderDefaultManaged>$(GameFolderDefault)/$(AssemblyFolder)</GameFolderDefaultManaged>
    <GameFolderDefaultValid Condition="Exists('$(GameFolderDefaultManaged)/Assembly-CSharp.dll') and Exists('$(GameFolderDefaultManaged)/Assembly-CSharp-firstpass.dll') and Exists('$(GameFolderDefaultManaged)/UnityEngine.CoreModule.dll')">true</GameFolderDefaultValid>

    <GameInstallFolder Condition="'$(GameFolderRegistryValid)' == 'true'">$(GameFolderRegistry)</GameInstallFolder>
    <GameInstallFolder Condition="'$(GameInstallFolder)' == ''">$(GameFolderDefault)</GameInstallFolder>

    <GameFolder>$(GameInstallFolder)/$(AssemblyFolder)</GameFolder>
    <GameLibsFolder>$(GameFolder)</GameLibsFolder>

    <!-- Resolve the Windows Known Folder, including redirected Documents; keep explicit overrides. -->
    <DocumentsFolder Condition="'$(DocumentsFolder)' == ''">$([System.Environment]::GetFolderPath(System.Environment+SpecialFolder.MyDocuments))</DocumentsFolder>
    <ModFolder Condition="'$(ModFolder)' == '' and '$(DocumentsFolder)' != ''">$(DocumentsFolder)/$(DevModsFolder)</ModFolder>
  </PropertyGroup>

  <Target Name="ValidateOniWindowsPath"
          BeforeTargets="ResolveReferences"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DoNotBuildAsMod)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipOniPathValidation)' != 'true'">
    <Error Condition="'$(ModFolder)' == ''"
           Text="Unable to resolve Windows Documents. Set DocumentsFolder or ModFolder explicitly before building a development mod." />
    <Error Condition="'$(GameFolderRegistryValid)' != 'true' and '$(GameFolderDefaultValid)' != 'true'"
           Text="Unable to locate a valid Oxygen Not Included installation. Checked registry InstallLocation for Steam App 457140 and fallback '$(GameFolderDefault)'. Set GameInstallFolder/GameFolder/GameLibsFolder in Directory.Build.props.user to OxygenNotIncluded_Data/Managed." />
  </Target>
</Project>