<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DoNotBuildAsMod>true</DoNotBuildAsMod>
    <IsMod>false</IsMod>
    <IsPacked>false</IsPacked>
    <GenerateMetadata>false</GenerateMetadata>
  </PropertyGroup>

  <ItemGroup>
    <Reference Remove="@(Reference)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Shared/Replication/SnapshotTimeline.cs" Link="Replication/SnapshotTimeline.cs" />
    <Compile Include="../../Shared/Networking/TransportConfigurationMigration.cs" Link="Networking/TransportConfigurationMigration.cs" />
    <Compile Include="../../ONI_United/Networking/Sessions/Player.cs" Link="Networking/Sessions/Player.cs" />
    <Compile Include="../../ONI_United/Networking/Sessions/Session.cs" Link="Networking/Sessions/Session.cs" />
    <Compile Include="../../ONI_United/Networking/Sessions/SessionHandshakeRules.cs" Link="Networking/Sessions/SessionHandshakeRules.cs" />
  </ItemGroup>

</Project>
