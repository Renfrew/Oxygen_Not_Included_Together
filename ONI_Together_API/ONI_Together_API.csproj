<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPacked>true</IsPacked>
    <DoNotBuildAsMod>true</DoNotBuildAsMod>

    <PackageId>ONI_United_API</PackageId>
    <AssemblyName>ONI_United_API</AssemblyName>
    <Version>0.9.0</Version>
    <Authors>Lyraedan, Sgt_Imalas</Authors>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Description>API for third-party mods to add multiplayer features to Multiplayer: ONI United. Enables mods to detect multiplayer sessions, access network state, and integrate with the ONI United ecosystem.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Renfrew/Oxygen_Not_Included_Together</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Renfrew/Oxygen_Not_Included_Together</RepositoryUrl>
    <PackageTags>oni;oxygen-not-included;oxygen-not-included-together;oxygen-not-included-multiplayer;oni-together;onitogether;oni-multiplayer</PackageTags>
    <PackageReadmeFile>README_NUGET.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)\*.dll" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README_NUGET.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
